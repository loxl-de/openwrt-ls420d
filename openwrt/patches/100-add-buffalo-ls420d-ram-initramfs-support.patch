diff --git a/target/linux/mvebu/files/arch/arm/boot/dts/marvell/armada-370-buffalo-ls420d.dts b/target/linux/mvebu/files/arch/arm/boot/dts/marvell/armada-370-buffalo-ls420d.dts
new file mode 100644
index 0000000000000000000000000000000000000000..ead9c12821ec1f05a20e22d8409f47a790fff7e1
--- /dev/null
+++ b/target/linux/mvebu/files/arch/arm/boot/dts/marvell/armada-370-buffalo-ls420d.dts
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: (GPL-2.0-or-later OR MIT)
+/*
+ * Device Tree for the Buffalo LinkStation LS420D.
+ *
+ * LS420D hardware information adapted from work by Jeremy J. Peper,
+ * based on device trees by Steve Shih <shihsung@gmail.com> and
+ * Toha <tohenk@yahoo.com>. OpenWrt integration for the Buffalo LS420D.
+ *
+ * The LS420D shares the Armada 370 platform and most board wiring with the
+ * LS421DE. Keep that maintained OpenWrt description as the source base and
+ * override only the hardware differences verified during LS420D bring-up.
+ */
+
+/dts-v1/;
+
+#include "armada-370-buffalo-ls421de.dts"
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+
+/ {
+	model = "Buffalo LinkStation LS420D";
+	compatible = "buffalo,ls420d", "marvell,armada370",
+		     "marvell,armada-370-xp";
+};
+
+/* The LS420D has no LS421DE PCIe-connected Renesas USB 3 controller. */
+&pciec {
+	status = "disabled";
+};
+
+/* No SD-card slot is fitted. */
+&sdio {
+	status = "disabled";
+};
+
+/* This board contains SPI NOR only; exposing imaginary NAND is dangerous. */
+&nand_controller {
+	status = "disabled";
+};
+
+/* The Armada USB 2 port is present. Its power-enable line is active-low. */
+&{/regulators/regulator@0} {
+	/delete-property/ enable-active-high;
+	gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;
+};
+
+/* Do not poll sleeping backup disks through the drivetemp thermal zone. */
+&{/thermal-zones/hdd-thermal} {
+	status = "disabled";
+};
+
+/*
+ * gpio-button-hotplug has a deliberately small code map. Use accepted event
+ * codes for the verified LS420D GPIOs; disk-presence contacts are switches.
+ */
+&{/gpio_keys} {
+	pinctrl-0 = <&pmx_buttons &pmx_hdd_present>;
+
+	hdd1-present {
+		label = "Hard Disk 1 Present";
+		linux,code = <BTN_0>;
+		linux,input-type = <EV_SW>;
+		gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;
+	};
+
+	hdd2-present {
+		label = "Hard Disk 2 Present";
+		linux,code = <BTN_1>;
+		linux,input-type = <EV_SW>;
+		gpios = <&gpio0 12 GPIO_ACTIVE_LOW>;
+	};
+};
+
+&{/gpio_keys/power} {
+	linux,code = <KEY_POWER>;
+	linux,input-type = <EV_SW>;
+};
+
+&{/gpio_keys/function} {
+	linux,code = <KEY_CONFIG>;
+};
+
+&{/gpio_leds/system_red} {
+	label = "ls420d:red:function";
+};
+
+&{/gpio_leds/power_white} {
+	label = "ls420d:white:power";
+};
+
+&{/gpio_leds/power_red} {
+	label = "ls420d:red:power";
+};
+
+&{/gpio_leds/power_orange} {
+	label = "ls420d:orange:power";
+};
+
+&{/gpio_leds/system_white} {
+	label = "ls420d:white:function";
+};
+
+&{/gpio_leds/hdd1_red} {
+	label = "ls420d:red:hdd1";
+};
+
+&{/gpio_leds/hdd2_red} {
+	label = "ls420d:red:hdd2";
+};
+
+&ethphy0 {
+	/* LED2/INTn signals restart versus poweroff to the Buffalo bootloader. */
+	marvell,reg-init = <0x3 0x10 0xf000 0x0981>;
+};
+
+&pinctrl {
+	pmx_hdd_present: pmx-hdd-present {
+		marvell,pins = "mpp11", "mpp12";
+		marvell,function = "gpio";
+	};
+};
