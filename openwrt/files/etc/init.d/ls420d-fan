#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034 # rc.common consumes service metadata.
USE_PROCD=1
START=97
STOP=88

start_service() {
    /usr/sbin/ls420d-fan full || return 1
    procd_open_instance
    procd_set_param command /usr/sbin/ls420d-fan supervise
    procd_set_param respawn 3600 2 0
    procd_set_param term_timeout 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    # Deliberately leave fan fully on; never restore competing step_wise writes.
    /usr/sbin/ls420d-fan full
}
