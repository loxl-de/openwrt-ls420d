# SPDX-License-Identifier: MIT

CONFIG_TARGET_mvebu=y
CONFIG_TARGET_mvebu_cortexa9=y
CONFIG_TARGET_mvebu_cortexa9_DEVICE_buffalo_ls420d=y

CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_NONE=y
# CONFIG_TARGET_ROOTFS_SQUASHFS is not set
# CONFIG_TARGET_ROOTFS_UBIFS is not set

# This is a single-port NAS host, not a router. Drop the router defaults that
# would otherwise run as services: they cost RAM and attack surface and have
# no job here. The host firewall (firewall4/nftables) stays.
# CONFIG_PACKAGE_dnsmasq is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_ppp-mod-pppoe is not set

# Keep the public artifact useful for board bring-up without embedding any
# device-specific configuration, key, disk identity, or backup job. The pull
# backup tool and the disk standby daemon are generic; both stay idle until a
# companion configures them.
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_hd-idle=y
CONFIG_PACKAGE_rsync=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_hdparm=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_usbutils=y

CONFIG_DEVEL=y
CONFIG_CCACHE=y

# CPU/HDD-aware generic fan service needs the disk temperature sensor driver.
CONFIG_PACKAGE_kmod-hwmon-drivetemp=y
