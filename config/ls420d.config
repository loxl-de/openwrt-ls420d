# SPDX-License-Identifier: MIT

CONFIG_TARGET_mvebu=y
CONFIG_TARGET_mvebu_cortexa9=y
CONFIG_TARGET_mvebu_cortexa9_DEVICE_buffalo_ls420d=y

CONFIG_TARGET_ROOTFS_INITRAMFS=y
# Keep the decompressed kernel and its relocated zImage below the companion.
CONFIG_TARGET_INITRAMFS_COMPRESSION_XZ=y
# CONFIG_TARGET_INITRAMFS_COMPRESSION_NONE is not set
# CONFIG_TARGET_ROOTFS_SQUASHFS is not set
# CONFIG_TARGET_ROOTFS_UBIFS is not set

# Shared NAS and pull-backup tools; no site configuration, keys or jobs.
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_hdparm=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_rsync=y
CONFIG_RSYNC_acl=y
CONFIG_RSYNC_xattr=y
# Use the existing Dropbear SSH client; do not start an rsync listener.
CONFIG_DROPBEAR_DBCLIENT=y
# CONFIG_PACKAGE_rsyncd is not set
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_usbutils=y

CONFIG_DEVEL=y
CONFIG_CCACHE=y

# CPU/HDD-aware generic fan service needs the disk temperature sensor driver.
CONFIG_PACKAGE_kmod-hwmon-drivetemp=y

# Use upstream's release mode so the transient APK signing key is not installed.
# Package signature verification and the official OpenWrt key remain enabled.
CONFIG_BUILDBOT=y
CONFIG_SIGNED_PACKAGES=y
CONFIG_SIGNATURE_CHECK=y
CONFIG_REPRODUCIBLE_DEBUG_INFO=y
CONFIG_KERNEL_BUILD_USER="builder"
CONFIG_KERNEL_BUILD_DOMAIN="buildhost"

# BUILDBOT also defaults to extra build products and the sysupgrade client.
# This project only builds the selected RAM image and its matching packages.
# CONFIG_ALL is not set
# CONFIG_ALL_NONSHARED is not set
# CONFIG_ALL_KMODS is not set
# CONFIG_SDK is not set
# CONFIG_SDK_LLVM_BPF is not set
# CONFIG_IB is not set
# CONFIG_MAKE_TOOLCHAIN is not set
# CONFIG_COLLECT_KERNEL_DEBUG is not set
# CONFIG_JSON_CYCLONEDX_SBOM is not set
# CONFIG_PACKAGE_owut is not set

# No environment writer is needed for RAM boot or reading the Ethernet MAC.
# CONFIG_PACKAGE_uboot-envtools is not set

# Single-port NAS host: retain the host firewall, not router daemons.
# CONFIG_PACKAGE_dnsmasq is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_ppp-mod-pppoe is not set
